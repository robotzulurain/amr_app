{
  "build": {
    "env": {
      "VITE_API_URL": "https://amrthabo.onrender.com"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://amrthabo.onrender.com/api/$1",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
